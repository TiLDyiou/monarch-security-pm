{
  "rewrites": [
    {
      "source": "/api/entrade/:path*",
      "destination": "https://services.entrade.com.vn/:path*"
    },
    {
      "source": "/api/cafef/:path*",
      "destination": "https://cafef.vn/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/entrade/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=60, s-maxage=300, stale-while-revalidate=600"
        }
      ]
    },
    {
      "source": "/api/cafef/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=60, s-maxage=300, stale-while-revalidate=600"
        }
      ]
    }
  ]
}
